## @file
#  ACPI tables for the Orange Pi Zero 2W (Allwinner H618).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = OrangePiZero2WAcpiTables
  # Must match PcdAcpiTableStorageFile so AcpiPlatformDxe installs these tables.
  FILE_GUID                      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Sources]
  AcpiTables.h
  Dbg2.aslc
  Dsdt.asl
  Fadt.aslc
  Gtdt.aslc
  Madt.aslc
  Spcr.aslc

[Packages]
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  OrangePiZero2W/OrangePiZero2W.dec

[FixedPcd]
  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum
  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum
  gArmTokenSpaceGuid.PcdGicDistributorBase
  gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultBaudRate
  gOrangePiZero2WTokenSpaceGuid.PcdGicInterruptInterfaceHBase
  gOrangePiZero2WTokenSpaceGuid.PcdGicInterruptInterfaceVBase
  gOrangePiZero2WTokenSpaceGuid.PcdGicVgicMaintIrq
  gOrangePiZero2WTokenSpaceGuid.PcdGicPmuIrq0
  gOrangePiZero2WTokenSpaceGuid.PcdGicPmuIrq1
  gOrangePiZero2WTokenSpaceGuid.PcdGicPmuIrq2
  gOrangePiZero2WTokenSpaceGuid.PcdGicPmuIrq3
