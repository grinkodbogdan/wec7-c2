/** @file
  Multiple APIC Description Table (MADT): four Cortex-A53 cores on a GIC-400.

  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <AcpiHelperMacros.h>
#include <IndustryStandard/Acpi.h>
#include <Library/ArmLib.h>
#include <Library/PcdLib.h>
#include "AcpiTables.h"

#pragma pack (1)
typedef struct {
  EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER    Header;
  EFI_ACPI_6_3_GIC_STRUCTURE                             GicInterfaces[H618_CPU_COUNT];
  EFI_ACPI_6_3_GIC_DISTRIBUTOR_STRUCTURE                 GicDistributor;
} H618_MULTIPLE_APIC_DESCRIPTION_TABLE;
#pragma pack ()

#define H618_GICC(Cpu, PmuIrq)                                                 \
  EFI_ACPI_6_3_GICC_STRUCTURE_INIT (                                           \
    Cpu,                                    /* GicId */                        \
    Cpu,                                    /* AcpiCpuUid (matches DSDT _UID) */ \
    GET_MPID (0, Cpu),                      /* Mpidr */                        \
    EFI_ACPI_6_0_GIC_ENABLED,               /* Flags */                        \
    PmuIrq,                                 /* PerformanceInterruptGsiv */     \
    FixedPcdGet64 (PcdGicInterruptInterfaceBase),                              \
    FixedPcdGet64 (PcdGicInterruptInterfaceVBase),                             \
    FixedPcdGet64 (PcdGicInterruptInterfaceHBase),                             \
    FixedPcdGet32 (PcdGicVgicMaintIrq),     /* VGICMaintenanceInterrupt */     \
    0,                                      /* GICRBaseAddress (GICv2: none) */ \
    0,                                      /* ProcessorPowerEfficiencyClass */ \
    0                                       /* SpeOverflowInterrupt */         \
    )

H618_MULTIPLE_APIC_DESCRIPTION_TABLE  Madt = {
  {
    ACPI_HEADER (
      EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
      H618_MULTIPLE_APIC_DESCRIPTION_TABLE,
      EFI_ACPI_6_3_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
      ),
    0,                                      // LocalApicAddress
    0,                                      // Flags
  },
  {
    H618_GICC (0, FixedPcdGet32 (PcdGicPmuIrq0)),
    H618_GICC (1, FixedPcdGet32 (PcdGicPmuIrq1)),
    H618_GICC (2, FixedPcdGet32 (PcdGicPmuIrq2)),
    H618_GICC (3, FixedPcdGet32 (PcdGicPmuIrq3)),
  },
  EFI_ACPI_6_0_GIC_DISTRIBUTOR_INIT (0, FixedPcdGet64 (PcdGicDistributorBase), 0, 2)
};

VOID *CONST  ReferenceAcpiTable = &Madt;
