diff --git a/lib/libc/gen/tls.c b/lib/libc/gen/tls.c
index 0e9b087486..0bb21d074f 100644
--- a/lib/libc/gen/tls.c
+++ b/lib/libc/gen/tls.c
@@ -51,7 +51,7 @@ struct tls_tcb *__libc_allocate_tls(void);
 void __libc_free_tls(struct tls_tcb *tcb);
 void __libc_call_init(void);
 
-#if !defined(RTLD_STATIC_TLS_VARIANT_II)
+#if !defined(RTLD_STATIC_TLS_VARIANT_I) && !defined(RTLD_STATIC_TLS_VARIANT_II)
 #error "Unsupported TLS layout"
 #endif
 
@@ -61,6 +61,9 @@ static size_t tls_static_space;
 static size_t tls_init_size;
 static void *tls_init;
 static struct tls_tcb *initial_tcb;
+#ifdef RTLD_STATIC_TLS_VARIANT_I
+static size_t tls_static_align = RTLD_STATIC_TLS_ALIGN;
+#endif
 #endif
 
 void *__libc_tls_get_addr(void *ti);
@@ -80,6 +83,75 @@ __libc_tls_get_addr_tcb(struct tls_tcb *tcb __unused, void *got_ptr __unused)
 
 #ifndef PIC
 
+#ifdef RTLD_STATIC_TLS_VARIANT_I
+
+/*
+ * Variant I (aarch64): the thread pointer addresses a 16-byte ABI
+ * header (tcb_dtv, tcb_pthread) inside the TCB, and the TLS block
+ * follows at TLS_TP_HDR_SIZE rounded up to the segment's alignment.
+ * The rest of the TCB lies below the thread pointer.  tcb_unused[0]
+ * remembers the allocation.
+ */
+void
+__libc_free_tls(struct tls_tcb *tcb)
+{
+	if (tcb == initial_tcb) {
+		/* initial_tcb was allocated with mmap(), cannot call free() */
+	} else {
+		free(tcb->tcb_unused[0]);
+	}
+}
+
+struct tls_tcb *
+__libc_allocate_tls(void)
+{
+	size_t align, tlsoff, bytes;
+	struct tls_tcb *tcb;
+	Elf_Addr *dtv;
+	char *raw, *tp;
+
+	align = tls_static_align;
+	if (align < RTLD_STATIC_TLS_ALIGN)
+		align = RTLD_STATIC_TLS_ALIGN;
+	tlsoff = roundup2(TLS_TP_HDR_SIZE, align);
+	bytes = TLS_TCB_TP_OFFSET + align + tlsoff + tls_static_space +
+	    3 * sizeof(*dtv);
+
+	/* See the variant II version below on mmap() for the first. */
+	if (initial_tcb == NULL) {
+		bytes = (bytes + PAGE_MASK) & ~(size_t)PAGE_MASK;
+		raw = mmap((void *)1, bytes, PROT_READ | PROT_WRITE,
+			   MAP_PRIVATE | MAP_ANON, -1, 0);
+	} else {
+		raw = malloc(bytes);
+	}
+
+	tp = (char *)roundup2((uintptr_t)raw + TLS_TCB_TP_OFFSET, align);
+	tcb = (struct tls_tcb *)(tp - TLS_TCB_TP_OFFSET);
+	dtv = (Elf_Addr *)(tp + tlsoff + tls_static_space);
+
+	memset(tcb, 0, sizeof(*tcb));
+	tcb->tcb_self = tcb;
+	tcb->tcb_dtv = dtv;
+	tcb->tcb_unused[0] = raw;
+
+	dtv[0] = 1;
+	dtv[1] = 1;
+	dtv[2] = (Elf_Addr)(tp + tlsoff);
+
+	memcpy(tp + tlsoff, tls_init, tls_init_size);
+	memset(tp + tlsoff + tls_init_size, 0,
+	    tls_static_space - tls_init_size);
+
+	if (initial_tcb == NULL) {
+		initial_tcb = tcb;
+		tls_set_tcb(tcb);
+	}
+	return (tcb);
+}
+
+#else /* RTLD_STATIC_TLS_VARIANT_II */
+
 /*
  * Free Static TLS, weakly bound to _rtld_free_tls()
  */
@@ -168,6 +240,8 @@ __libc_allocate_tls(void)
 	return (tcb);
 }
 
+#endif /* RTLD_STATIC_TLS_VARIANT_I */
+
 #else
 
 struct tls_tcb *
@@ -236,6 +310,9 @@ _libc_init_tls(void)
 			    phdr[i].p_align);
 			tls_init_size = phdr[i].p_filesz;
 			tls_init = (void*) phdr[i].p_vaddr;
+#ifdef RTLD_STATIC_TLS_VARIANT_I
+			tls_static_align = phdr[i].p_align;
+#endif
 		}
 	}
 #endif
