--- a/src/gallium/targets/osmesa/target.c
+++ b/src/gallium/targets/osmesa/target.c
@@ -26,6 +26,29 @@
 
 #include "sw/null/null_sw_winsys.h"
 
+#ifdef GALLIUM_FREEDRENO
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "freedreno/drm/freedreno_drm_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+
+/*
+ * freedreno reads its driconf options from the screen config (the DRI
+ * loader would fill it in); a NULL config faults in fd_screen_create.
+ */
+static const driOptionDescription osmesa_fd_driconf[] = {
+   DRI_CONF_SECTION_MISCELLANEOUS
+      DRI_CONF_DISABLE_CONSERVATIVE_LRZ(false)
+   DRI_CONF_SECTION_END
+   DRI_CONF_SECTION_DEBUG
+      DRI_CONF_DISABLE_THROTTLING(false)
+   DRI_CONF_SECTION_END
+};
+static driOptionCache osmesa_fd_info, osmesa_fd_options;
+#endif
+
 
 struct pipe_screen *
 osmesa_create_screen(void);
@@ -37,6 +60,31 @@
    struct sw_winsys *winsys;
    struct pipe_screen *screen;
 
+#ifdef GALLIUM_FREEDRENO
+   /*
+    * DragonFly/arm64: OSMesa on a GPU.  With OSMESA_DRM_DEVICE naming a
+    * DRM device (the Adreno's /dev/dri/card0), render with freedreno;
+    * the frontend reads the result back into the caller's buffer as it
+    * does for softpipe.  Without it, or if that fails, the software path.
+    */
+   const char *drm = getenv("OSMESA_DRM_DEVICE");
+   if (drm && *drm) {
+      int fd = open(drm, O_RDWR | O_CLOEXEC);
+      if (fd >= 0) {
+         struct pipe_screen_config config = {
+            .options = &osmesa_fd_options,
+            .options_info = &osmesa_fd_info,
+         };
+         driParseOptionInfo(&osmesa_fd_info, osmesa_fd_driconf,
+                            ARRAY_SIZE(osmesa_fd_driconf));
+         screen = fd_drm_screen_create_renderonly(fd, NULL, &config);
+         if (screen)
+            return debug_screen_wrap(screen);
+         close(fd);
+      }
+   }
+#endif
+
    /* We use a null software winsys since we always just render to ordinary
     * driver resources.
     */
