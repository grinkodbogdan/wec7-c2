diff --git a/sys/netproto/802_11/ieee80211_crypto.h b/sys/netproto/802_11/ieee80211_crypto.h
index 98f1d35781..8a01553bd9 100644
--- a/sys/netproto/802_11/ieee80211_crypto.h
+++ b/sys/netproto/802_11/ieee80211_crypto.h
@@ -84,6 +84,9 @@ struct ieee80211_key {
 #define	IEEE80211_KEY_SWENMIC	0x0040	/* host-based enmic */
 #define	IEEE80211_KEY_SWDEMIC	0x0080	/* host-based demic */
 #define	IEEE80211_KEY_DEVKEY	0x0100	/* device key request completed */
+#define	IEEE80211_KEY_NOIV	0x0200	/* firmware adds the IV (offload) */
+#define	IEEE80211_KEY_NOIVMGT	0x0400	/* ... for management frames too */
+#define	IEEE80211_KEY_NOMIC	0x0800	/* firmware adds the MIC (offload) */
 #define	IEEE80211_KEY_CIPHER0	0x1000	/* cipher-specific action 0 */
 #define	IEEE80211_KEY_CIPHER1	0x2000	/* cipher-specific action 1 */
 	ieee80211_keyix	wk_keyix;	/* h/w key index */
@@ -102,7 +105,8 @@ struct ieee80211_key {
 	(IEEE80211_KEY_XMIT | IEEE80211_KEY_RECV | IEEE80211_KEY_GROUP | \
 	 IEEE80211_KEY_NOREPLAY)
 #define	IEEE80211_KEY_DEVICE		/* flags owned by device driver */\
-	(IEEE80211_KEY_DEVKEY|IEEE80211_KEY_CIPHER0|IEEE80211_KEY_CIPHER1)
+	(IEEE80211_KEY_DEVKEY|IEEE80211_KEY_CIPHER0|IEEE80211_KEY_CIPHER1| \
+	 IEEE80211_KEY_NOIV|IEEE80211_KEY_NOIVMGT|IEEE80211_KEY_NOMIC)
 
 #define	IEEE80211_KEY_SWCRYPT \
 	(IEEE80211_KEY_SWENCRYPT | IEEE80211_KEY_SWDECRYPT)
@@ -223,6 +227,8 @@ ieee80211_crypto_enmic(struct ieee80211vap *vap,
 	struct ieee80211_key *k, struct mbuf *m, int force)
 {
 	const struct ieee80211_cipher *cip = k->wk_cipher;
+	if (k->wk_flags & IEEE80211_KEY_NOMIC)
+		return (1);
 	return (cip->ic_miclen > 0 ? cip->ic_enmic(k, m, force) : 1);
 }
 
