/*
 * Linker script for the DragonFly arm64 platform kernel.
 *
 * The kernel is linked at KERNBASE (same value pc64 uses) and is fully
 * position independent until locore has turned the MMU on, so it can be
 * loaded at any 2MB-aligned physical address by a bootloader that speaks
 * the Linux arm64 Image protocol (QEMU -kernel, U-Boot booti, Android abl).
 */
OUTPUT_FORMAT("elf64-littleaarch64")
OUTPUT_ARCH(aarch64)
ENTRY(_start)

KERNBASE = 0xffffffff80000000;

SECTIONS
{
	. = KERNBASE;
	kernbase = .;
	.text : {
		KEEP(*(.text.boot))
		*(.text .text.*)
	}
	. = ALIGN(4096);
	etext = .;
	.rodata : { *(.rodata .rodata.*) }
	. = ALIGN(4096);
	.data : { *(.data .data.*) }
	. = ALIGN(4096);
	__bss_start = .;
	.bss : { *(.bss .bss.*) *(COMMON) }
	. = ALIGN(4096);
	__bss_end = .;
	_end = .;
	/DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
}
