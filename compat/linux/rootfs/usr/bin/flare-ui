#!/bin/sh
# flare-ui [appl [args...]]: (re)start the Arcan phone shell with an appl from
# /usr/share/arcan/appl (default flarehome). `fdb appl` uses this to reload
# an edited appl in seconds. The shell's output goes to the console and to
# /tmp/flare-ui.log (`fdb log`).
appl=${1:-flarehome}
[ $# -gt 0 ] && shift
# Mesa's shader cache, filled at build time (a QEMU run of this shell): a
# boot compiles only shaders that are new.
export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast GBM_ALWAYS_SOFTWARE=1 MESA_SHADER_CACHE_DIR=/var/cache/mesa
mkdir -p /var/cache/mesa
export ARCAN_VIDEO_DISPLAY_DEVICE=/dev/dri/card0 XDG_RUNTIME_DIR=/tmp SHELL=/bin/sh
# Arcan's watchdog kills its engine when a frame takes over 5 s; with
# software rendering on a 1080x1920 panel the first one can (compat/arcan/patches/0005).
export ARCAN_WATCHDOG_TIMEOUT_MS=60000
# llvmpipe: compile shaders without LLVM's optimization passes (several times
# faster to compile; the shell's 2D shaders barely run slower).
export GALLIVM_PERF=no_opt
if [ ! -f "/usr/share/arcan/appl/$appl/$appl.lua" ]; then
    echo "flare-ui: no appl '$appl' in /usr/share/arcan/appl" >&2
    exit 1
fi
# Installed apps (/opt/apps/ID.apk, with ID.name and ID.png): each an
# Arcan target running atl-run on it, and an icon on flarehome's launcher
# (its installed.lua).
db=/tmp/arcan.sqlite
appl_dir=/usr/share/arcan/appl/flarehome
if [ "$appl" = flarehome ] && [ -d /opt/apps ]; then
    mkdir -p "$appl_dir/icons"
    echo "return {" > "$appl_dir/installed.lua"
    for apk in /opt/apps/*.apk; do
        [ -e "$apk" ] || continue
        id=$(basename "$apk" .apk)
        name=$(cat "/opt/apps/$id.name" 2>/dev/null || echo "$id")
        arcan_db -d $db add_target "$id" BIN /usr/bin/atl-run "$apk" > /dev/null 2>&1
        arcan_db -d $db add_config "$id" default > /dev/null 2>&1
        icon=nil
        if [ -e "/opt/apps/$id.png" ]; then
            cp "/opt/apps/$id.png" "$appl_dir/icons/app-$id.png"
            icon="\"icons/app-$id.png\""
        fi
        echo "  {name = \"$name\", target = \"$id\", icon = $icon}," >> "$appl_dir/installed.lua"
    done
    echo "}" >> "$appl_dir/installed.lua"
fi
# the phone's state for the status bar (battery, Wi-Fi), once
[ "$appl" = flarehome ] && ! pidof flare-statusd > /dev/null && (flare-statusd > /dev/null 2>&1 &)
if pidof arcan > /dev/null; then
    killall arcan
    while pidof arcan > /dev/null; do usleep 100000; done
fi
echo "flare-ui: starting $appl at $(cut -d' ' -f1 /proc/uptime) s since boot" | tee -a /tmp/flare-ui.log > /dev/console
(arcan -d /tmp/arcan.sqlite -p /usr/share/arcan/resources -t /usr/share/arcan/appl \
    -T /usr/share/arcan/scripts "$appl" "$@" 2>&1 | tee -a /tmp/flare-ui.log > /dev/console) \
    < /dev/null > /dev/null 2>&1 &
echo "flare-ui: $appl started"
