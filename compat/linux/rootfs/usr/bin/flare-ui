#!/bin/sh
# flare-ui [appl [args...]]: (re)start the Arcan phone shell with an appl from
# /usr/share/arcan/appl (default flarehome). `fdb appl` uses this to reload
# an edited appl in seconds. The shell's output goes to the console and to
# /tmp/flare-ui.log (`fdb log`).
appl=${1:-flarehome}
[ $# -gt 0 ] && shift
export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast GBM_ALWAYS_SOFTWARE=1 MESA_SHADER_CACHE_DISABLE=true
export ARCAN_VIDEO_DISPLAY_DEVICE=/dev/dri/card0 XDG_RUNTIME_DIR=/tmp
# Arcan's watchdog kills its engine when a frame takes over 5 s; with
# software rendering on a 1080x1920 panel the first one can (compat/arcan/patches/0005).
export ARCAN_WATCHDOG_TIMEOUT_MS=60000
# llvmpipe: compile shaders without LLVM's optimization passes (several times
# faster to compile; the shell's 2D shaders barely run slower).
export GALLIVM_PERF=no_opt
if [ ! -f "/usr/share/arcan/appl/$appl/$appl.lua" ]; then
    echo "flare-ui: no appl '$appl' in /usr/share/arcan/appl" >&2
    exit 1
fi
if pidof arcan > /dev/null; then
    killall arcan
    while pidof arcan > /dev/null; do usleep 100000; done
fi
echo "flare-ui: starting $appl at $(cut -d' ' -f1 /proc/uptime) s since boot" | tee -a /tmp/flare-ui.log > /dev/console
(arcan -d /tmp/arcan.sqlite -p /usr/share/arcan/resources -t /usr/share/arcan/appl \
    -T /usr/share/arcan/scripts "$appl" "$@" 2>&1 | tee -a /tmp/flare-ui.log > /dev/console) \
    < /dev/null > /dev/null 2>&1 &
echo "flare-ui: $appl started"
