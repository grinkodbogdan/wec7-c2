#!/bin/sh
# Flare OS — init script of the Linux personality (pid 1 runs /bin/sh /etc/rc).
# Everything below is unmodified busybox running on Flare's own kernel.
export PATH=/bin:/sbin:/usr/bin HOME=/root PS1='flare:\w# '
cat /etc/motd
# Linux's own drivers for the hardware the composition gives Linux (a phone's
# eMMC, touch screen, PMIC...): the driver host, in the background. The
# board's arguments (linux.txt) come last, so they can set the log level.
start_linuxdrv() {
    if [ -e /dev/flarehw ] && [ -x /usr/bin/linuxdrv ] && [ -z "$linuxdrv_started" ]; then
        linuxdrv_started=1
        (linuxdrv /etc/linuxdrv/board.dtb loglevel=8 initcall_debug $(cat /etc/linuxdrv/cmdline 2>/dev/null) \
            > /dev/console 2>&1 &)
    fi
}
# FLARE_BOOT=quick (a phone's composition): the hardware first, no test
# suites or demos, straight to the shell.
if [ "$FLARE_BOOT" = quick ]; then
    start_linuxdrv
    echo "rc: [$(cut -d' ' -f1 /proc/uptime) s] quick boot: $(uname -sr), $(grep MemTotal /proc/meminfo | tr -s ' ')"
    echo "rc: components:"; cat /proc/components
    # The driver host's input devices (a phone's touch screen and keys) must
    # be described before a user interface opens them.
    if [ -n "$linuxdrv_started" ]; then
        i=0
        while [ ! -e /tmp/linuxdrv.ready ] && [ $i -lt 600 ]; do
            usleep 100000; i=$((i + 1))
            # (the driver host gone: no point waiting)
            [ $((i % 10)) = 0 ] && ! pidof linuxdrv > /dev/null && break
        done
        if [ -e /tmp/linuxdrv.ready ]; then
            echo "rc: [$(cut -d' ' -f1 /proc/uptime) s] the driver host's devices are ready"
        elif pidof linuxdrv > /dev/null; then
            echo "rc: [$(cut -d' ' -f1 /proc/uptime) s] the driver host is not ready after 60 s (its log above)"
        else
            echo "rc: [$(cut -d' ' -f1 /proc/uptime) s] the driver host stopped (its last words above)"
        fi
    fi
    # (tests: the first event that reaches Flare's input device eventN,
    # N = $FLARE_TEST_INPUT; its type, code and value, after the time)
    [ -n "$FLARE_TEST_INPUT" ] && (sh /etc/net-test > /dev/console 2>&1 &)
    [ -n "$FLARE_TEST_INPUT" ] && \
        (echo "rc: event$FLARE_TEST_INPUT read:$(head -c 24 /dev/input/event$FLARE_TEST_INPUT | od -An -tx1 -j16)" \
            > /dev/console &)
    # The phone shell, if this root filesystem has it and there is a display.
    # Shaders: Mesa's cache, filled at build time (a QEMU run of this shell),
    # so a boot compiles only what is new.
    export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast GBM_ALWAYS_SOFTWARE=1 MESA_SHADER_CACHE_DIR=/var/cache/mesa
    mkdir -p /var/cache/mesa
    [ -e /dev/fdb ] && command -v fdbd > /dev/null && (fdbd > /dev/console 2>&1 &)
    if [ -e /dev/dri/card0 ] && command -v arcan > /dev/null; then
        # (the kernel's tick profiler, from here until the shell is ready)
        echo profile on > /dev/flarectl
        flare-ui flarehome
        # Say when the shell is ready (seconds since boot), or, if it is not
        # after 90 s, where it is: its last words and what its threads wait
        # in. Reporting only: nothing here may slow the shell down.
        (i=0
         while [ $i -lt 90 ]; do
             if grep -q "flarehome: ready" /tmp/flare-ui.log 2>/dev/null; then
                 echo "rc: phone shell ready at $(cut -d' ' -f1 /proc/uptime) s since boot ($(grep MemFree /proc/meminfo | tr -s ' '), CPU $(grep 'cpu MHz' /proc/cpuinfo | tr -dc 0-9) MHz)"
                 if [ -n "$FLARE_TEST_INPUT" ]; then
                     # (tests: every bucket, paced for the serial console)
                     echo "profile all" > /dev/flarectl
                     cat /dev/flarectl | while read -r l; do echo "$l"; usleep 3000; done
                 else
                     echo profile > /dev/flarectl && cat /dev/flarectl
                 fi
                 # ... and the shell idle for 10 s (what it costs at rest)
                 echo profile on > /dev/flarectl
                 sleep 10
                 echo "rc: the shell idle for 10 s:"
                 echo profile > /dev/flarectl && cat /dev/flarectl
                 exit 0
             fi
             sleep 1; i=$((i + 1))
         done
         echo "console on" > /dev/flarectl
         echo "rc: the phone shell is not up after 90 s (uptime $(cut -d' ' -f1 /proc/uptime) s); its log:"
         tail -n 5 /tmp/flare-ui.log
         echo "rc: its threads:"
         grep -e "^pid" -e arcan /proc/flare-threads | head -12) > /dev/console 2>&1 &
        # (tests: the thread list itself)
        [ -n "$FLARE_TEST_INPUT" ] && (sleep 5; grep -c arcan /proc/flare-threads | \
            sed 's/^/rc: arcan threads: /' > /dev/console) &
    fi
    echo "rc: starting an interactive shell (type 'exit' to power off)"
    cd /root
    exec /bin/sh
fi
echo "rc: uname -a: $(uname -a)"
echo "rc: components:"; cat /proc/components
# Hot-restart the console driver while everything keeps using it.
if grep -qw uart /proc/components; then
    echo restart uart > /dev/flarectl && cat /dev/flarectl
    echo "rc: still talking after the console driver restarted"
fi
# Hot-restart the storage driver while storage-test is reading the disk.
if grep -qw storage /proc/components; then
    echo restart storage > /dev/flarectl && cat /dev/flarectl
fi
echo "rc: arithmetic: 6 * 7 = $((6 * 7))"
mkdir -p /tmp/demo && echo "written by sh" > /tmp/demo/file.txt
echo "rc: file round-trip: $(cat /tmp/demo/file.txt)"
echo "rc: pipeline: $(echo one two three | wc -w) words"
echo "rc: ls /: $(ls / | tr '\n' ' ')"
echo "rc: memory: $(grep MemTotal /proc/meminfo)"
/usr/bin/std-test hello from rc
echo "rc: std-test exit status $?"
sleep 1 && echo "rc: slept 1 second"
/etc/run-tests
start_linuxdrv
# Android apps, straight from their APKs: no init, zygote or system_server.
for apk in /data/app/*.apk; do
    /usr/bin/droid $apk
    echo "rc: droid $(basename $apk) exit status $?"
done
# The display: Mesa renders through /dev/dri/card0 (Flare's KMS device over
# the panel's shared memory), first a self-check, then the Arcan phone shell.
export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast GBM_ALWAYS_SOFTWARE=1 MESA_SHADER_CACHE_DIR=/var/cache/mesa
mkdir -p /var/cache/mesa
[ -e /dev/dri/card0 ] && command -v kmstest > /dev/null && kmstest
# ART, the Android runtime itself (from Android Translation Layer's standalone
# build), running a Java program interpreted.
if command -v art-run > /dev/null; then
    art-run -cp /opt/art/tests/hello-art.jar HelloArt > /tmp/art.log 2>&1
    s=$?; grep "^art:" /tmp/art.log; echo "rc: art exit status $s"
fi
# fdb, the debug bridge (host: `cargo fdb`), and the Arcan phone shell.
[ -e /dev/fdb ] && command -v fdbd > /dev/null && (fdbd > /dev/console 2>&1 &)
[ -e /dev/dri/card0 ] && command -v arcan > /dev/null && flare-ui flarehome
# What is running now (on a phone this is the last screenful).
echo "rc: running components:"; cat /proc/components
[ -d /dev/input ] && echo "rc: input devices: $(ls /dev/input | tr '\n' ' ')"
echo "rc: starting an interactive shell (type 'exit' to power off)"
cd /root
exec /bin/sh
