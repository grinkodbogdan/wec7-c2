#!/bin/sh
# Flare OS — init script of the Linux personality (pid 1 runs /bin/sh /etc/rc).
# Everything below is unmodified busybox running on Flare's own kernel.
export PATH=/bin:/sbin:/usr/bin HOME=/root PS1='flare:\w# '
cat /etc/motd
echo "rc: uname -a: $(uname -a)"
echo "rc: components:"; cat /proc/components
# Hot-restart the console driver while everything keeps using it.
echo restart uart > /dev/flarectl && cat /dev/flarectl
echo "rc: still talking after the console driver restarted"
# Hot-restart the storage driver while storage-test is reading the disk.
echo restart storage > /dev/flarectl && cat /dev/flarectl
echo "rc: arithmetic: 6 * 7 = $((6 * 7))"
mkdir -p /tmp/demo && echo "written by sh" > /tmp/demo/file.txt
echo "rc: file round-trip: $(cat /tmp/demo/file.txt)"
echo "rc: pipeline: $(echo one two three | wc -w) words"
echo "rc: ls /: $(ls / | tr '\n' ' ')"
echo "rc: memory: $(grep MemTotal /proc/meminfo)"
/usr/bin/std-test hello from rc
echo "rc: std-test exit status $?"
sleep 1 && echo "rc: slept 1 second"
/etc/run-tests
# Android apps, straight from their APKs: no init, zygote or system_server.
for apk in /data/app/*.apk; do
    /usr/bin/droid $apk
    echo "rc: droid $(basename $apk) exit status $?"
done
# The display: Mesa renders through /dev/dri/card0 (Flare's KMS device over
# the panel's shared memory), first a self-check, then the Arcan phone shell.
export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast GBM_ALWAYS_SOFTWARE=1 MESA_SHADER_CACHE_DISABLE=true
kmstest
# ART, the Android runtime itself (from Android Translation Layer's standalone
# build), running a Java program interpreted.
art-run -cp /opt/art/tests/hello-art.jar HelloArt > /tmp/art.log 2>&1
s=$?; grep "^art:" /tmp/art.log; echo "rc: art exit status $s"
# fdb, the debug bridge (host: `cargo fdb`), and the Arcan phone shell.
fdbd > /dev/console 2>&1 &
flare-ui flarehome
echo "rc: starting an interactive shell (type 'exit' to power off)"
cd /root
exec /bin/sh
