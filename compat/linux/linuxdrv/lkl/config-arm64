# Linux options for the driver host on 64-bit ARM phones. Derived from QRT's
# ports/lkl-arm64.sh additions (lkl/config-arm64 there), keeping only what
# Flare gives to Linux: the SoC's clocks, pins, RPM and regulators, input,
# storage, and QEMU virt's devices for testing the same path. Not QRT's
# "every postmarketOS MSM8953 driver" set or the display (Flare keeps the
# panel), which would make the program too big for a phone's boot image.
CONFIG_LKL_QRT_SOC=y
CONFIG_PCI=n
CONFIG_COMPILE_TEST=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_DEVTMPFS=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
CONFIG_PRINTK_TIME=y
# devices_deferred (linux.c's summary: what each waiting device waits for)
CONFIG_DEBUG_FS=y
# the SoC: clocks, pins, interrupts, the RPM co-processor and its regulators
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_GCC_8953=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_A53PLL=n
CONFIG_RESET_CONTROLLER=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_MSM8953=y
CONFIG_GPIOLIB=y
CONFIG_QCOM_SMEM=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
# QCOM_SCM: PINCTRL_MSM selects it; its device (/firmware/scm) is dropped from
# the tree Linux gets (hardware/boards/xiaomi/tissot/linux.txt), so it never probes.
# input: the touch screen (FocalTech FT5x06 on I2C), the power and volume keys
CONFIG_I2C=y
CONFIG_I2C_QUP=y
CONFIG_DMADEVICES=y
CONFIG_QCOM_BAM_DMA=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QCOM_PON=y
# storage: eMMC and the SD card
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# QEMU virt (the test board): virtio-mmio disk, keyboard, tablet
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y
# QEMU virt's GPIO controller (its power key, through gpio-keys): tests the GPIO interrupt path
CONFIG_GPIO_PL061=y
CONFIG_ARCH_QCOM=y
# Linux with virtual memory (LKL's MMU mode; QRT's "Argon"): the driver host
# maps Linux's RAM at CONFIG_LKL_MEMORY_START through /dev/flarehw
CONFIG_MMU=y
# operating points: the RPM power domains' corners and the SDHC clock tables
# (without them qcom-rpmpd fails with -EOPNOTSUPP and everything behind it
# waits). PM_OPP has no prompt: only another option can select it; devfreq
# does (its governors stay off).
CONFIG_PM_DEVFREQ=y
# the PMICs' GPIOs (pm8953 and pmi8950 gpio@c000)
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
# Not the interconnect drivers: their bus nodes are not Linux's, and with them
# the SDHC would wait for providers that never appear (without them, a
# device's interconnect paths are simply none).
# USB device mode: the DWC3 controller and its PHY, with the serial gadget
# (/dev/ttyGS0, the host's /dev/ttyACM0) that carries fdb
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_G_SERIAL=y
