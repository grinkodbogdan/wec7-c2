# Flare Hardware Description — board layer
#
# A reference "phone" assembled on QEMU virt. This is the first Flare port:
# everything board-specific lives here, not in the kernel.

fhd = 0
kind = "board"
name = "qemu-virt-phone"
soc = "qemu/virt"
description = "Reference phone board on QEMU virt, used for framekernel bring-up"

[memory.dram]
size = 0x40000000          # 1 GiB fitted

[device.rtc0]
status = "okay"

[device.gpio0]
status = "okay"
role = "buttons"           # QEMU wires the power key to line 3

[device.virtio31]
status = "okay"
role = "storage"           # virtio-blk: the userdata disk
# When given to Linux (system/qemu-virt-linuxdrv.boot.toml): an edge-
# triggered interrupt in Linux's device tree, so `cargo xtask linuxdrv-test`
# covers the edge path that Qualcomm's RPM replies take.
linux-irq = "edge"

[device.virtio30]
status = "okay"
role = "touchscreen"       # virtio-tablet: absolute pointer over the panel

[device.virtio29]
status = "okay"
role = "keyboard"          # virtio-keyboard: hardware keys

[device.virtio28]
status = "okay"
role = "debug"             # virtio console: the fdb debug bridge (a USB port on a phone)

[device.virtio27]
status = "okay"
role = "network"           # virtio-net: QEMU's user network (Wi-Fi's stand-in)

[device.fwcfg0]
status = "okay"
role = "display"           # ramfb: 480x854 portrait panel

[chosen]
console = "uart0"

[emulation]
qemu-machine = "virt"
qemu-cpu = "cortex-a53"
memory-mib = 1024
# Emulated devices behind the described ones. @disk is the disk image the
# build tools create.
qemu-args = ["-global", "virtio-mmio.force-legacy=false",
             "-drive", "if=none,file=@disk,format=raw,id=userdata",
             "-device", "virtio-blk-device,drive=userdata",
             "-device", "virtio-tablet-device",
             "-device", "virtio-keyboard-device",
             "-device", "virtio-serial-device",
             "-chardev", "socket,id=fdb,path=@fdb,server=on,wait=off",
             "-device", "virtconsole,chardev=fdb",
             "-netdev", "user,id=net0",
             "-device", "virtio-net-device,netdev=net0",
             "-device", "ramfb"]
